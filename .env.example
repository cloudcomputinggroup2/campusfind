# ==============================================================================
# CampusFind - Environment Configuration File
# ==============================================================================

# Core Django Settings
SECRET_KEY=django-insecure-campusfind-capstone-dev-key-change-in-production-2026!#
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,testserver

# ==============================================================================
# Database Configuration (Amazon RDS / Local SQLite)
# ==============================================================================
# For local development, leave DB_ENGINE empty to use default db.sqlite3
# For AWS RDS PostgreSQL or MySQL, configure the variables below:
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Example for Amazon RDS PostgreSQL:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=campusfind_db
# DB_USER=campusadmin
# DB_PASSWORD=your-secure-rds-password
# DB_HOST=campusfind-db.cxxxxxxxxxxx.us-east-1.rds.amazonaws.com
# DB_PORT=5432

# Or specify a full DATABASE_URL connection string:
# DATABASE_URL=postgres://campusadmin:your-secure-rds-password@campusfind-db.cxxxxxxxxxxx.us-east-1.rds.amazonaws.com:5432/campusfind_db

# ==============================================================================
# Storage Configuration (Amazon S3 / Local Media)
# ==============================================================================
# Set USE_S3=True when deploying to AWS with S3 bucket
USE_S3=False

# Amazon S3 Credentials & Bucket Details
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=campusfind-item-images-capstone
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_FILE_OVERWRITE=False

# ==============================================================================
# AWS CloudWatch & Monitoring (Optional metadata)
# ==============================================================================
CLOUDWATCH_LOG_GROUP=/campusfind/application-logs
AWS_REGION=us-east-1
